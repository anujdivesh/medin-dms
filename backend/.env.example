# Copy to .env and fill in real values. Do NOT commit .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=dms
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LEGACY_DB_NAME=dms
LEGACY_DB_USER=dms_user
LEGACY_DB_PASSWORD=
LEGACY_DB_HOST=localhost
LEGACY_DB_PORT=5432

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=
FRONTEND_URL=http://localhost:5173

# Same port/host as the current backend/ (FastAPI) - `python manage.py
# runserver 0.0.0.0:8000` (Django doesn't read PORT/HOST itself; this is
# just here as the documented convention for this project).
PORT=8000
HOST=0.0.0.0
