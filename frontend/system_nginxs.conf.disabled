
server {
  listen      443 ssl;
  client_max_body_size 1000M;
  server_name opmdata.gem.spc.int;

  ssl_certificate /etc/letsencrypt/live/opmdata.gem.spc.int/fullchain.pem; # managed by Certbot
  ssl_certificate_key /etc/letsencrypt/live/opmdata.gem.spc.int/privkey.pem; # managed by Certbot
  ssl_protocols TLSv1.2 TLSv1.3;

  # -----------------------
  # Upstreams
  # -----------------------
  set $frontend_upstream "127.0.0.1:9005";
  set $es_upstream "127.0.0.1:9200";

  # -----------------------
  # Backend API proxy - MUST come before general /dms/ location
  # -----------------------
  location ^~ /dms/api/ {
      proxy_pass http://127.0.0.1:9006/api/;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Port $server_port;
      proxy_buffering off;
      proxy_redirect off;  # Prevent Nginx from rewriting redirects
  }

  # -----------------------
  # Direct Elasticsearch passthrough - MUST come before general /dms/ location
  # -----------------------
  location ^~ /dms/es/ {
      proxy_pass http://127.0.0.1:9200/;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;

      proxy_set_header Origin "";
      proxy_buffering off;
      rewrite ^/dms/es/(.*)$ /$1 break;
  }

  # -----------------------
  # PyGeoAPI proxy - MUST come before general /dms/ location
  # -----------------------
  location ^~ /dms/pygeoapi/ {
      proxy_pass http://127.0.0.1:5000/;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Port $server_port;
      proxy_buffering off;
      proxy_redirect off;
  }

  # -----------------------
  # Ollama proxy - route directly to Ollama container
  # -----------------------
  location ^~ /ollama/ {
      proxy_pass http://127.0.0.1:11434/;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Port $server_port;
      proxy_buffering off;
      proxy_redirect off;
  }

  # -----------------------
  # Forward all other DMS traffic to frontend container
  # -----------------------
  location ^~ /dms/ {
      proxy_pass http://127.0.0.1:9005;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Port $server_port;
      proxy_buffering off;
  }
#-------------
# DMS Lanind image
#---------------

location = /dms/dms_landing.jpg {
    proxy_pass http://127.0.0.1:9006/dms/dms_landing.jpg;
}

  # -----------------------
  # Other existing proxies
  # -----------------------
  location /api {
      proxy_pass http://localhost:8081;
  }
  location /v1 {
      proxy_pass http://localhost:8080;
  }
  location /oceandata-api {
      proxy_pass http://localhost:8080;
  }
  location /shoreline {
      proxy_pass http://localhost:8086;
  }
  location /dbms {
      proxy_pass http://localhost:8083;
  }
  location /tcap {
      proxy_pass http://localhost:8080;
  }
  location /erddap {
      proxy_pass http://localhost:8080;
  }
  location /file {
      proxy_pass http://localhost:8085;
  }
  location /odbms {
      proxy_pass http://localhost:8087;
  }
  location /assets/ {
      proxy_pass http://localhost:8087;
  }
  location /media/ {
      proxy_pass http://localhost:8087;
  }
  location /middleware/ {
      proxy_pass http://localhost:8089;
  }
  location /ocean_api/ {
      proxy_pass http://localhost:8082;
  }
  location /oceandata {
      proxy_pass http://localhost:8080;
  }
  location /monitoring {
      proxy_pass http://localhost:3000;
  }
  location /service {
      proxy_pass http://localhost:8000;
  }
}

